# Keep the Docker build context (and image) small.
# Version control & local virtualenvs — never needed in the image.
.git
.gitignore
.gitattributes
.venv
venv/
env/
ENV/

# Python caches / build artefacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend tooling
node_modules/

# Editor / IDE
.vscode/
.idea/
*.swp

# Docs & CI (not needed at runtime)
readme-files/
.github/
*.md

# Docker itself
Dockerfile
.dockerignore

# Local-only secrets / databases
env.py
.env
*.sqlite3
