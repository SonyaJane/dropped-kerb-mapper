# Normalise line endings: store text as LF in the repo, check out as LF.
# This stops CRLF from an editor/OS re-churning every file.
* text=auto eol=lf

# README.md is UTF-16 — treat as binary so git never touches its bytes/endings.
README.md -text

# Large geospatial fixtures via Git LFS (binary; keep out of text normalisation).
mapper/fixtures/counties/* filter=lfs diff=lfs merge=lfs -text
mapper/fixtures/local_authorities/* filter=lfs diff=lfs merge=lfs -text
